# Sourcelume dev environment configuration for the Quarkus runtime & Atlas backend.
#
# IMPORTANT: Apache Atlas itself is configured via its OWN .env file, inside
# dev-support/vendor/atlas-docker/ once you've run ./setup.sh (see README.md).
# Do not duplicate Atlas's internal settings here — this file holds the
# values the Sourcelume Quarkus runtime and local developer tooling need.

# --- Shared Docker network ---
SOURCELUME_NETWORK=sourcelume-network

# --- How the Sourcelume Quarkus runtime reaches Apache Atlas ---
# Use http://localhost:21000 when running the registry on the host (via mvn or IDE).
# Use http://atlas:21000 when running inside a Docker container.
SOURCELUME_ATLAS_URL=http://localhost:21000
SOURCELUME_ATLAS_USER=admin
SOURCELUME_ATLAS_PASSWORD=atlasR0cks!
SOURCELUME_ATLAS_PASSWORD_FILE=

# --- Atlas backend choice, passed through when running the vendored stack ---
# postgres is recommended for local dev over hbase: it's a lighter stack
# and Postgres ships proper multi-arch images (arm64 & x86_64).
ATLAS_BACKEND=postgres
