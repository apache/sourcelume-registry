# Sourcelume dev environment placeholders.
#
# IMPORTANT: Apache Atlas itself is configured via its OWN .env file, inside
# dev-support/vendor/atlas-docker/ once you've run ./setup.sh (see README.md).
# Do not duplicate Atlas's internal settings here - this file only holds the
# values Sourcelume's own code and tooling need.

# --- Shared network ---
SOURCELUME_NETWORK=sourcelume-network

# --- How Sourcelume's own code (e.g. WiringSpike) reaches Atlas ---
# localhost works when Sourcelume code runs on the host (current state, via
# `mvn exec:java`). If/when ingest-worker is containerized and joins
# sourcelume-network, change this to Atlas's container/service name instead.
SOURCELUME_ATLAS_URL=http://localhost:21000
SOURCELUME_ATLAS_USER=admin
# Atlas's own docs list the default dev password as `atlasR0cks!` - confirm
# this matches whatever the vendored atlas-docker/.env actually sets before
# relying on it for anything beyond throwaway local dev.
SOURCELUME_ATLAS_PASSWORD=atlasR0cks!

# --- Atlas backend choice, passed through when running the vendored stack ---
# postgres is recommended for local dev over hbase: it's a lighter stack
# (skips HBase/Solr/Kafka) and Postgres ships proper multi-arch images,
# which matters on Apple Silicon where some of the older Hadoop-ecosystem
# images have not been confirmed to have arm64 builds.
ATLAS_BACKEND=postgres

# --- Placeholders for modules not yet built (see docs/architecture.md) ---
# SOURCELUME_QUEUE_HOST=
# SOURCELUME_QUEUE_PORT=
# SOURCELUME_CACHE_HOST=
# SOURCELUME_CACHE_PORT=
