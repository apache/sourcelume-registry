          "isIndexable": true,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "rawJsonLd",
          "typeName": "string",
          "cardinality": "SINGLE",
          "isIndexable": false,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "validationIssues",
          "typeName": "string",
          "cardinality": "SINGLE",
          "isIndexable": false,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "sha256",
          "typeName": "string",
          "description": "Hex SHA-256 over the received request bytes, so the stored document can be checked against what was actually submitted.",
          "cardinality": "SINGLE",
          "isIndexable": false,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "validatedBy",
          "typeName": "string",
          "description": "The validator chain that produced the verdict (comma-separated validator ids).",
          "cardinality": "SINGLE",
          "isIndexable": false,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "validatedAt",
          "typeName": "string",
          "description": "When the verdict was produced (ISO-8601, UTC).",
          "cardinality": "SINGLE",
          "isIndexable": false,
