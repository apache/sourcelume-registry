        {
          "name": "recordAttributes",
          "typeName": "string",
          "cardinality": "SINGLE",
          "isOptional": true,
          "isIndexable": false,
          "isUnique": false
        },
        {
          "name": "recordFacets",
          "typeName": "string",
          "cardinality": "SINGLE",
          "isOptional": true,
          "isIndexable": false,
          "isUnique": false
        },
        {
          "name": "recordFacetIndex",
          "typeName": "string",
          "cardinality": "SINGLE",
          "isOptional": true,
          "isIndexable": false,
          "isUnique": false
        },
        {
          "name": "recordFacetTokens",
          "typeName": "string",
          "cardinality": "SINGLE",
          "isOptional": true,
          "isIndexable": false,
          "indexType": "DEFAULT",
          "isUnique": false
        }
      ]
    },
    {
      "name": "sourcelume_model",
      "typeVersion": "1.0",
      "description": "Entity for a model described by a stored TrainingProvenanceRecord: the model producer's claim of which datasets the model was trained on. Carries the same ingest lifecycle attributes as sourcelume_dataset plus the mapped model attributes. The referenced datasets are not attributes \u2014 their provenance state is resolved at read time, per the spec design. qualifiedName (the record IRI) and name are inherited from Asset; a model is not a DataSet.",
      "superTypes": [
        "Asset"
      ],
      "attributeDefs": [
        {
          "name": "modelUri",
          "typeName": "string",
          "description": "The model's own identifier (typically a persistent IRI such as a Hugging Face URL), not this record's id.",
          "cardinality": "SINGLE",
          "isIndexable": true,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "modelVersion",
          "typeName": "string",
          "description": "Model version or checkpoint, if versioned.",
          "cardinality": "SINGLE",
          "isIndexable": true,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "disclosure",
          "typeName": "string",
          "description": "How much of the training data the producer discloses: complete, partial, or undisclosed.",
          "cardinality": "SINGLE",
          "isIndexable": true,
          "isOptional": true,
          "isUnique": false
        },
        {
          "name": "recordStatus",
          "typeName": "sourcelume_record_status",
