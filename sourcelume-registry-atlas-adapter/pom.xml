  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.sourcelume</groupId>
    <artifactId>sourcelume-registry</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>sourcelume-registry-atlas-adapter</artifactId>
  <packaging>jar</packaging>
  <name>Apache Sourcelume Registry - Atlas Adapter</name>

  <description>Apache Atlas metadata storage plugin. Owns the Atlas REST client, entity mapping and type-definition initialization. Uses JDK HttpClient and Jackson without framework or Core dependencies.</description>

  <dependencies>
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-spi-tck</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Existing Sourcelume entity DTOs used only by the Atlas mapping and catalog views. -->
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-common</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Jackson for the wire payloads (version from the parent BOM import) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Logging API; framework wiring belongs to the runtime. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Atlas schema resources are initialized by this plugin. -->
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-typedefs</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
