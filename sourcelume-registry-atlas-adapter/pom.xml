<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.sourcelume</groupId>
        <artifactId>sourcelume-registry</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>sourcelume-registry-atlas-adapter</artifactId>
    <name>Apache Sourcelume Registry - Atlas Adapter (thin REST client)</name>
    <packaging>jar</packaging>

    <description>
        Encapsulates Apache Atlas interactions behind a backend-neutral AtlasAdapter
        interface using Sourcelume types. The default implementation is a thin REST
        client over the JDK HttpClient + Jackson — it pulls in NO atlas-client-v2 /
        atlas-intg dependency tree, only talks to the 4 Atlas REST endpoints the
        registry needs. Atlas-specific JSON mapping lives entirely in the
        implementation; the interface exposes only Sourcelume DTOs.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.apache.sourcelume</groupId>
            <artifactId>sourcelume-registry-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.sourcelume</groupId>
            <artifactId>sourcelume-registry-typedefs</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Quarkus CDI + config + health, provided by the Quarkus runtime.
             The adapter module is a plain jar that the ingest-worker (the Quarkus
             app) pulls in; Quarkus annotations here are resolved at the app's build. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
