    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.sourcelume</groupId>
        <artifactId>sourcelume-registry</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>sourcelume-registry-ingest-worker</artifactId>
    <name>Apache Sourcelume Registry - Ingest Worker</name>
    <packaging>jar</packaging>

    <description>
        STEEL THREAD ONLY. Proves that this module can (a) resolve and read a resource bundled in
        the locally-built sourcelume-spec jar, (b) load the Sourcelume Atlas typedefs bundled in
        sourcelume-registry-typedefs, and (c) register them against a running Apache Atlas instance.

        Does NOT yet implement: queue consumption, signature verification against sourcelume-attest,
        or schema/SHACL validation against sourcelume-spec.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.apache.sourcelume</groupId>
            <artifactId>sourcelume-registry-typedefs</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.sourcelume</groupId>
            <artifactId>sourcelume-spec</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.atlas</groupId>
            <artifactId>atlas-client-v2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.atlas</groupId>
            <artifactId>atlas-intg</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <mainClass>org.apache.sourcelume.registry.ingest.worker.WiringSpike</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
