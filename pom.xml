    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache</groupId>
        <artifactId>apache</artifactId>
        <version>39</version>
        <relativePath />
    </parent>

    <groupId>org.apache.sourcelume</groupId>
    <artifactId>sourcelume-registry</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Apache Sourcelume Registry</name>
    <description>Registry for Apache Sourcelume.</description>

    <!--
      STEEL THREAD SCOPE ONLY.
      This parent currently lists only the two modules needed to prove that a locally-built
      sourcelume-spec jar can be consumed by this project, and that this project can talk to
      a running Apache Atlas instance and register the Sourcelume typedefs.

      NOT included yet (see docs/architecture.md for the full design - library modules
      first, then the thin app-* Spring Boot runners):
        sourcelume-registry-common
        sourcelume-registry-atlas-adapter   (the ONLY module allowed to use atlas-client-v2)
        sourcelume-registry-atlas-rest      (read-only Atlas access for the query path)
        sourcelume-registry-messaging
        sourcelume-registry-ingest-api
        sourcelume-registry-cache
        sourcelume-registry-query-api
        sourcelume-registry-export
        sourcelume-registry-app-ingest
        sourcelume-registry-app-worker
        sourcelume-registry-app-query
        sourcelume-registry-app-export
        sourcelume-registry-tests

      Also not yet done (docs/architecture.md "Dependency management"): importing the
      spring-boot-dependencies BOM below. Once it is imported it owns the Jackson version
      and the hand-pinned jackson.version property here should be deleted, not raised.
    -->
    <modules>
        <module>sourcelume-registry-typedefs</module>
        <module>sourcelume-registry-common</module>
        <module>sourcelume-registry-atlas-adapter</module>
        <module>sourcelume-registry-ingest-worker</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency Versions -->
        <spring-boot.version>3.3.5</spring-boot.version>
        <sourcelume-spec.version>0.0.1-SNAPSHOT</sourcelume-spec.version>

        <!-- Plugin Versions -->
        <exec-maven-plugin.version>3.2.0</exec-maven-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.sourcelume</groupId>
                <artifactId>sourcelume-spec</artifactId>
                <version>${sourcelume-spec.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sourcelume</groupId>
                <artifactId>sourcelume-registry-typedefs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sourcelume</groupId>
                <artifactId>sourcelume-registry-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sourcelume</groupId>
                <artifactId>sourcelume-registry-atlas-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>21</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
