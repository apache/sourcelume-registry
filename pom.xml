<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.apache.sourcelume</groupId>
    <artifactId>sourcelume-registry</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Apache Sourcelume Registry</name>

    <description>
        Apache Sourcelume Registry — Quarkus-based spike.

        This is a deliberately minimal slice through the Registry architecture,
        parallel to the Spring Boot registry-spike branch. It proves three pieces
        of wiring connect using Quarkus, CDI, and a thin JDK HttpClient instead of
        Spring Boot and atlas-client-v2:

        1. A locally-built sourcelume-spec jar can be depended on and its resources read.
        2. A backend-neutral AtlasAdapter (with a thin REST client implementation)
           can reach a running Apache Atlas instance and register typedefs.
        3. A Quarkus application starts, bootstraps the typedefs on startup, and
           exposes a readiness health check.

        Everything else from the full architecture (messaging, query-api, export,
        cache, the app-* runners beyond the worker) is intentionally left out.
        See docs/architecture.md for the full module design.
    </description>

    <modules>
        <module>sourcelume-registry-typedefs</module>
        <module>sourcelume-registry-common</module>
        <module>sourcelume-registry-atlas-adapter</module>
        <module>sourcelume-registry-ingest-worker</module>
    </modules>

    <properties>
        <!-- Java 21 baseline (LTS). CI should also run on 25. Skip 26 (non-LTS).
             See dev-list thread on Java baseline + framework choice (Sept 2026). -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency Versions -->
        <quarkus.version>3.33.3</quarkus.version>
        <jackson.version>2.18.0</jackson.version>
        <sourcelume-spec.version>0.0.1-SNAPSHOT</sourcelume-spec.version>

        <!-- Mockito self-attach is deprecated on Java 21+ and will break on
             future JDKs. Configure the Byte Buddy agent explicitly via
             -javaagent in Surefire so tests stay stable across JDK bumps.
             See Calvin's dev-list note (Sept 2026).
             The version matches what Quarkus 3.33.x pulls (byte-buddy-agent 1.17.8).
             Override with -DbyteBuddyAgentPath=... if your local cache layout differs. -->
        <byteBuddyAgentPath>${settings.localRepository}/net/bytebuddy/byte-buddy-agent/1.17.8/byte-buddy-agent-1.17.8.jar</byteBuddyAgentPath>

        <!-- Plugin Versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus BOM owns the Quarkus + Jakarta + Jackson versions -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.sourcelume</groupId>
                <artifactId>sourcelume-spec</artifactId>
                <version>${sourcelume-spec.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <!-- Mockito self-attach is deprecated on Java 21+ and will break on
                     future JDKs. Configure the Byte Buddy agent explicitly via
                     -javaagent in Surefire so tests stay stable across JDK bumps.
                     See Calvin's dev-list note (Sept 2026). -->
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-javaagent:${byteBuddyAgentPath}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
