<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.sourcelume</groupId>
        <artifactId>sourcelume-registry</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>sourcelume-registry-validation-jsonschema</artifactId>
    <packaging>jar</packaging>

    <name>Apache Sourcelume Registry - Validation Plugin: JSON Schema</name>

    <description>
        JSON Schema (draft 2020-12) validation plugin for ProvenanceRecord documents.

        Part of the modular RecordValidator plugin architecture: this module
        provides the structural validation stage ("json-schema", order 100) and
        registers itself via META-INF/services. It validates the raw JSON
        document against the sourcelume-spec JSON Schema, with format
        assertions enabled (date-time, uri) for parity with the Python
        reference validator (tools/validate.py, jsonschema[format]).

        Deliberately lightweight: depends only on the core SPI, common
        (SpecResourceLoader), and networknt json-schema-validator. No RDF
        machinery — that lives in sourcelume-registry-validation-shacl.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.apache.sourcelume</groupId>
            <artifactId>sourcelume-registry-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.sourcelume</groupId>
            <artifactId>sourcelume-registry-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
