<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.sourcelume</groupId>
    <artifactId>sourcelume-registry</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>sourcelume-registry-runtime-quarkus</artifactId>
  <packaging>jar</packaging>
  <name>Apache Sourcelume Registry - Quarkus Runtime</name>

  <description>Quarkus HTTP runtime and composition root for the Sourcelume Registry. Selects a metadata storage provider, manages initialization and shutdown, and exposes the backend-neutral record API.</description>

  <dependencyManagement>
    <dependencies>
      <!-- Quarkus BOM owns the Quarkus + Jakarta + Jackson versions for
                 this module only; the parent dependencyManagement stays as-is. -->
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-spi-tck</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Backend-neutral ingest and HTTP runtime. -->
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spec jar (JSON-LD context, schema, SHACL) — version from parent dependencyManagement -->
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-spec</artifactId>
    </dependency>
    <!-- Validation plugins: runtime wiring discovers them via the
             RecordValidator SPI (ServiceLoader); a registry without them
             would silently accept everything, so they are hard deps here. -->
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-validation-jsonschema</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sourcelume</groupId>
      <artifactId>sourcelume-registry-validation-shacl</artifactId>
    </dependency>

    <!-- Quarkus runtime -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <!-- Declared explicitly: Swagger UI is part of this module's contract,
         not something to inherit from quarkus-smallrye-openapi's wiring -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-swagger-ui</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-atlas-runtime-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.apache.sourcelume:sourcelume-registry-atlas-adapter</exclude>
                    <exclude>org.apache.sourcelume:sourcelume-registry-typedefs</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Use the JBoss LogManager in tests (standard Quarkus setup) so test
                 logging is initialized correctly on JDK 21+. -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
